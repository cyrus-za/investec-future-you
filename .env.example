# Set these on your Convex deployment with `npx convex env set NAME value`.
# Do NOT put real secrets in this file or commit a filled-in copy.
#
# The values below are Investec's publicly-documented SANDBOX demo
# credentials (safe to share; they only work against
# https://openapisandbox.investec.com, never production). See README.md.

INVESTEC_BASE_URL=https://openapisandbox.investec.com
INVESTEC_CLIENT_ID=
INVESTEC_CLIENT_SECRET=
INVESTEC_API_KEY=

# Frontend (written automatically by `npx convex dev` into .env.local):
# VITE_CONVEX_URL=
